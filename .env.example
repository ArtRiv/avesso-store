# The commerce-core instance this store runs against. Server-only on purpose:
# every API call goes through this app, so the browser never learns the API's
# origin and never holds a token. Prefixing this NEXT_PUBLIC_ would undo the
# whole BFF.
API_URL=https://commerce-core-kvlg.onrender.com

# This app's own origin. Must match the backend's APP_URL, which is what its
# verification e-mails, reset e-mails and Stripe return URLs are built from.
NEXT_PUBLIC_SITE_URL=http://localhost:5173
