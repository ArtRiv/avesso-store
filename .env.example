# ==============================================================================
# INFRAESTRUTURA & COMUNICAÇÃO BFF
# ==============================================================================
# Instância do commerce-core (NestJS API). Mantido exclusivamente no servidor
# (sem prefixo NEXT_PUBLIC_) para isolar credenciais e tokens do navegador.
API_URL=https://api.sualoja.com.br

# URL pública da loja Next.js. Deve coincidir com APP_URL no backend.
NEXT_PUBLIC_SITE_URL=https://www.sualoja.com.br

# ==============================================================================
# IDENTIDADE VISUAL & MARCA (PARAMETRIZAÇÃO CENTRALIZADA)
# ==============================================================================
# Nome fantasia da loja (usado no header, meta tags e e-mails)
NEXT_PUBLIC_STORE_NAME="AVESSO"

# Slogan institucional e descrição para SEO/OG tags
NEXT_PUBLIC_STORE_TAGLINE="Doze peças. Feitas para durar anos."
NEXT_PUBLIC_STORE_DESCRIPTION="Doze peças de algodão pesado, em lotes pequenos. Camisetas, moletons, calças e acessórios."

# Logotipo: URL pública de imagem (.svg ou .png com fundo transparente).
# Deixe vazio para utilizar o wordmark tipográfico nativo da loja.
NEXT_PUBLIC_STORE_LOGO_URL=""

# Cores institucionais (Hexadecimal). Opcionais — sobrescrevem os tokens CSS nativos:
# NEXT_PUBLIC_THEME_PRIMARY="#0a0a0a"     # Cor primária de texto, botões e foco
# NEXT_PUBLIC_THEME_ACCENT="#b0431e"      # Destaques, hover de links, wait bar
# NEXT_PUBLIC_THEME_BACKGROUND="#f5f3ef"  # Cor de fundo principal da página
# NEXT_PUBLIC_THEME_CARD="#ffffff"        # Fundo de cards, modais e superfícies
# NEXT_PUBLIC_THEME_BORDER="#e4e0d8"      # Linhas divisórias (hairlines)
# NEXT_PUBLIC_THEME_MUTED="#6b6560"       # Textos secundários e metadados

# ==============================================================================
# CONFORMIDADE LEGAL (DECRETO FEDERAL DO E-COMMERCE Nº 7.962/2013 & CDC)
# ==============================================================================
# Dados fiscais da empresa que opera a loja (obrigatórios no rodapé)
NEXT_PUBLIC_STORE_LEGAL_NAME="AVESSO Confecções LTDA"
NEXT_PUBLIC_STORE_CNPJ="42.318.907/0001-55"

# Endereço físico completo da sede empresarial
NEXT_PUBLIC_STORE_STREET="Rua Aurora"
NEXT_PUBLIC_STORE_NUMBER="148"
NEXT_PUBLIC_STORE_COMPLEMENT=""
NEXT_PUBLIC_STORE_NEIGHBORHOOD="República"
NEXT_PUBLIC_STORE_CITY="São Paulo"
NEXT_PUBLIC_STORE_STATE="SP"
NEXT_PUBLIC_STORE_CEP="01209-000"

# Canais oficiais de Atendimento ao Consumidor (SAC)
NEXT_PUBLIC_STORE_EMAIL="atendimento@avesso.com.br"
NEXT_PUBLIC_STORE_PHONE="(11) 99999-0000"
NEXT_PUBLIC_STORE_WHATSAPP="5511999990000"
NEXT_PUBLIC_STORE_HOURS="Seg a sex 9h às 18h"
